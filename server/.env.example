# ============================================================
# 案理（AnLi）环境变量配置模板
# 复制本文件为 .env 并按需修改；.env 已被 gitignore，不会上传
# ============================================================

# ---------- 敏感数据路径（均不会上传 GitHub）----------
# 数据根目录：SQLite 数据库（含账号、当事人、案件信息）
# 相对路径基于 server/ 目录，也可写绝对路径
ANLI_DATA_DIR=./data

# 案件资料文件夹（律师客户保密材料），默认 数据根目录/cases
# ANLI_CASES_DIR=./data/cases

# 文书模板目录（仅本地留档，无需备份，也不上传 GitHub）
# 可直接指向你电脑上的原始模板库，例如：
# ANLI_TEMPLATES_DIR=/Users/yang/Documents/LawWork/律师文书模板
ANLI_TEMPLATES_DIR=./data/templates

# 案件导出 zip 目录，默认 数据根目录/exports
# ANLI_EXPORTS_DIR=./data/exports

# ---------- 服务 ----------
PORT=3000
# 生产环境务必改为随机长字符串
JWT_SECRET=anli-local-secret-change-me

# ---------- AI 助手（二选一）----------
# 方式一：本地 Ollama
OLLAMA_URL=http://localhost:11434
AI_MODEL=qwen3:8b

# 方式二：OpenAI 兼容外部接口（留空则不启用）
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxxxxxx
# AI_MODEL=gpt-4o-mini
